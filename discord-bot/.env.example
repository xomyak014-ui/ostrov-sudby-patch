# Токен бота из Discord Developer Portal → Bot → Reset Token / Copy
DISCORD_TOKEN=your_bot_token_here

# ID канала, где будет панель создания тикетов
TICKET_CHANNEL_ID=1514901109322547240

# ID категории, куда создавать каналы тикетов (необязательно)
# TICKET_CATEGORY_ID=

# Роли поддержки (через запятую) — видят тикеты. Необязательно.
# SUPPORT_ROLE_IDS=

# Префикс имени канала тикета
TICKET_PREFIX=ticket
